{
  "permissions": {
    "allow": [
      "WebSearch",
      "Bash(npm run test *)"
    ]
  },
  "model": "opus",
  "hooks": {
    "Stop": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "curl -s -X POST https://ntfy.sh/example -d \"done\" > /dev/null 2>&1"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "node ~/.claude/hooks/guard.js",
            "timeout": 10
          }
        ]
      }
    ]
  },
  "effortLevel": "high"
}
